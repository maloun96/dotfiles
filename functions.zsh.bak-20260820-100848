# ─── Reshetcall platform stack (sipcf) ───────────────────────────────────────
# One dispatcher for the local Cloudflare Workers platform. Every service gets
# its own cmux tab, titled with the service's .test hostname.
#   sipio all | full | stop | status | seed | drift | open <svc> | web <svc> | ls
# Full docs: ~/.dotfiles/docs/sipio-stack.md
export SIPIO_ROOT="${SIPIO_ROOT:-$HOME/www/sipcf}"
export SIPIO_CMUX="${CMUX_BUNDLED_CLI_PATH:-/Applications/cmux.app/Contents/Resources/bin/cmux}"
export SIPIO_TAB_DELAY="${SIPIO_TAB_DELAY:-1.5}"   # shell-readiness wait before sending a command
_SIPIO_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/sipio/tabs"

# name | host (.test, also the tab title) | port | inspector | dir | command
# Every wrangler worker needs its OWN --inspector-port: they all default to 9229
# and every worker after the first dies with "Address already in use".
_sipio_core() {
	cat <<'REG'
idp|idp.sip.test|8791|9241|sip-idp/workers/id|npx wrangler dev --inspector-port 9241
app|app.sip.test|8793|9244|PBX/pbx-api/workers/api|npx wrangler dev --inspector-port 9244
ctl|control.sip.test|8794|9245|SIP/sip.io-v2|npx wrangler dev -c workers/api/wrangler.jsonc -c workers/nodes/wrangler.local.jsonc --port 8794 --inspector-port 9245
fin|billing.sip.test|8795|9242|FINANCE/financial-worker/workers/finance|npx wrangler dev --inspector-port 9242
pay|payments.sip.test|8796|9243|FINANCE/payment-gateway/workers/gateway|npx wrangler dev --inspector-port 9243
did|numbers.sip.test|8797|9250|DIDHUB/didhub-worker|npx wrangler dev -c wrangler.local.toml --port 8797 --inspector-port 9250
crm|crm.sip.test|8787|9251|CONTAQT/contaqt-crm/apps/api|npx wrangler dev --port 8787 --inspector-port 9251
mon|monitor.sip.test|8788|-|platform-dev|node flow-monitor/serve.cjs
fe|pbx.sip.test|3000|-|PBX/pbx/frontend|npm run dev
REG
}

# Everything else that runs locally (started by `sipio full`, not `sipio all`).
_sipio_extra() {
	cat <<'REG'
ws|workspace.sip.test|8703|9260|CONTAQT/contaqt-new/apps/workspace|npx wrangler dev --port 8703 --inspector-port 9260 -c wrangler.jsonc -c ../core/wrangler.jsonc
ev|events.sip.test|8704|9262|CONTAQT/contaqt-new/apps/events|npx wrangler dev --port 8704 --inspector-port 9262
chat|chat.sip.test|8706|9261|CONTAQT/contaqt-new/apps/chat|npx wrangler dev --port 8706 --inspector-port 9261
cnui|workspace-ui.sip.test|5177|-|CONTAQT/contaqt-new/apps/workspace-ui|npx vite --port 5177 --strictPort
dhc|dashboard.sip.test|5175|-|DIDHUB/didhub-customer|npx vite --port 5175 --strictPort
fraud|fraud.sip.test|5176|-|SIP/fraud-screen-dashboard|npx vite --port 5176 --strictPort
wp|webphone|-|-|PBX/webphone|npm run build:watch:dev
REG
}

_sipio_all_services() { _sipio_core; _sipio_extra; }

# Resolve a service by short name (app), hostname (app.sip.test) or repo
# directory (pbx-api). Repo lookup can be ambiguous — contaqt-new holds four
# services — so list the candidates instead of guessing.
_sipio_lookup() {
	local q="$1" rows n
	rows=$(_sipio_all_services | awk -F'|' -v q="$q" '$1==q || $2==q {print; exit}')
	[[ -n "$rows" ]] && { print -r -- "$rows"; return 0; }

	# p[1] is the PRODUCT GROUP since the workspace regroup (PBX/pbx-api/…), p[2] the repo — so match
	# both: `sipio pbx-api` still resolves, and `sipio PBX` lists that group's services as an ambiguity.
	rows=$(_sipio_all_services | awk -F'|' -v q="$q" '{split($5,p,"/"); if (p[1]==q || p[2]==q) print}')
	n=$(print -r -- "$rows" | grep -c '[^[:space:]]')
	(( n == 0 )) && return 1
	if (( n > 1 )); then
		{
			echo "'$q' matches several services — pick one:"
			print -r -- "$rows" | awk -F'|' '{printf "    %-6s %-22s %s\n", $1, $2, $5}'
		} >&2
		return 2
	fi
	print -r -- "$rows"
	return 0
}

# Free a port. `wrangler dev` spawns a child `workerd` that survives a plain
# TERM of its parent and keeps BOTH its service port and its inspector port
# bound, so re-check and escalate to -9.
_sipio_kill_port() {
	local port="$1" pids
	[[ "$port" == "-" ]] && return 1
	pids=$(lsof -ti tcp:"$port" 2>/dev/null)
	[[ -z "$pids" ]] && return 1
	print -r -- "$pids" | xargs kill 2>/dev/null
	sleep 1
	pids=$(lsof -ti tcp:"$port" 2>/dev/null)
	[[ -n "$pids" ]] && print -r -- "$pids" | xargs kill -9 2>/dev/null
	return 0
}

# Open one cmux tab, title it with the hostname, and run the command in it.
_sipio_tab() {
	local name="$1" host="$2" port="$3" dir="$4" cmd="$5" focus="${6:-false}"
	local ws ref out
	ws=$(CMUX_QUIET=1 "$SIPIO_CMUX" current-workspace 2>/dev/null)
	[[ -z "$ws" ]] && { echo "  ✗ $host — cmux not reachable (is the app running?)"; return 1; }

	out=$(CMUX_QUIET=1 "$SIPIO_CMUX" new-surface --type terminal --workspace "$ws" --focus "$focus" 2>&1)
	ref=$(print -r -- "$out" | grep -oE 'surface:[0-9]+' | head -1)
	[[ -z "$ref" ]] && { echo "  ✗ $host — could not create tab: $out"; return 1; }

	CMUX_QUIET=1 "$SIPIO_CMUX" rename-tab --surface "$ref" "$host" >/dev/null 2>&1

	# A fresh surface is still printing its login banner; sending too early
	# splices the command into that output and it never runs.
	sleep "$SIPIO_TAB_DELAY"
	CMUX_QUIET=1 "$SIPIO_CMUX" send-key --surface "$ref" ctrl+u >/dev/null 2>&1

	# Pin Node 22 — wrangler refuses anything older and fails opaquely.
	local full="cd ${SIPIO_ROOT}/${dir} && { command -v nvm >/dev/null && nvm use 22 >/dev/null 2>&1; }; ${cmd}"
	CMUX_QUIET=1 "$SIPIO_CMUX" send --surface "$ref" "$full" >/dev/null 2>&1
	CMUX_QUIET=1 "$SIPIO_CMUX" send-key --surface "$ref" enter >/dev/null 2>&1

	mkdir -p "${_SIPIO_STATE:h}"
	print -r -- "${host}|${ref}" >> "$_SIPIO_STATE"
	printf "  ▸ %-22s %-6s tab %s\n" "$host" "$port" "$ref"
	return 0
}

_sipio_start_set() {
	local listing="$1" first=1 name host port insp dir cmd
	while IFS='|' read -r name host port insp dir cmd; do
		[[ -z "$name" ]] && continue
		if (( first )); then _sipio_tab "$name" "$host" "$port" "$dir" "$cmd" true; first=0
		else _sipio_tab "$name" "$host" "$port" "$dir" "$cmd" false; fi
	done <<< "$listing"
}

# Start one or more services. `--here` (foreground, this shell) takes a single one.
_sipio_run() {
	local here=0 svc row rc first=1 name host port insp dir cmd
	local -a args rows
	for svc in "$@"; do
		case "$svc" in
			--here|-h) here=1 ;;
			*) args+=("$svc") ;;
		esac
	done
	(( ${#args} == 0 )) && { echo "usage: sipio run <svc> [<svc>…] [--here]" >&2; return 1; }

	# Resolve every name BEFORE touching a port — one typo must not leave half
	# the set killed and the other half restarted.
	for svc in "${args[@]}"; do
		row=$(_sipio_lookup "$svc"); rc=$?
		(( rc == 1 )) && { echo "unknown service: $svc  (try: sipio ls)" >&2; return 1; }
		(( rc != 0 )) && return 1          # ambiguous — _sipio_lookup listed the candidates
		rows+=("$row")
	done

	if (( here )); then
		(( ${#args} > 1 )) && { echo "--here runs one service in this shell — got ${#args}" >&2; return 1; }
		IFS='|' read -r name host port insp dir cmd <<< "${rows[1]}"
		_sipio_kill_port "$port" >/dev/null 2>&1
		_sipio_kill_port "$insp" >/dev/null 2>&1
		echo "▸ $host  (:$port)  — Ctrl+C to stop"
		( cd "$SIPIO_ROOT/$dir" && { command -v nvm >/dev/null && nvm use 22 >/dev/null 2>&1; }; eval "$cmd" )
		return
	fi

	# Restart semantics: free BOTH ports first. An orphaned workerd keeps the
	# inspector port bound, and the next start dies on 9xxx, not on the service port.
	for row in "${rows[@]}"; do
		IFS='|' read -r name host port insp dir cmd <<< "$row"
		_sipio_kill_port "$port" >/dev/null 2>&1
		_sipio_kill_port "$insp" >/dev/null 2>&1
		if (( first )); then _sipio_tab "$name" "$host" "$port" "$dir" "$cmd" true; first=0
		else _sipio_tab "$name" "$host" "$port" "$dir" "$cmd" false; fi
	done
}

function sipio() {
	local sub="${1:-help}"; shift 2>/dev/null

	case "$sub" in
		all)
			echo "Starting core platform stack in ${SIPIO_ROOT}"
			_sipio_start_set "$(_sipio_core)"
			echo "  · sipio status  to check health"
			;;
		full)
			echo "Starting FULL stack (core + contaqt-new + frontends)"
			_sipio_start_set "$(_sipio_all_services)"
			echo "  · sipio status  to check health"
			;;
		stop)
			local name host port insp dir cmd ref
			echo "Stopping services…"
			while IFS='|' read -r name host port insp dir cmd; do
				[[ -z "$name" ]] && continue
				_sipio_kill_port "$port" && echo "  ✗ $host (:$port)"
				_sipio_kill_port "$insp" >/dev/null   # orphaned workerd holds this too
			done <<< "$(_sipio_all_services)"
			pkill -f 'build:watch:dev' 2>/dev/null   # webphone + other portless watchers
			if [[ -f "$_SIPIO_STATE" ]]; then
				echo "Closing tabs…"
				while IFS='|' read -r host ref; do
					[[ -z "$ref" ]] && continue
					CMUX_QUIET=1 "$SIPIO_CMUX" close-surface --surface "$ref" >/dev/null 2>&1 && echo "  · closed $host"
				done < "$_SIPIO_STATE"
				rm -f "$_SIPIO_STATE"
			fi
			;;
		status)
			local name host port insp dir cmd code
			printf "  %-22s %-6s %s\n" "HOST" "PORT" "HTTP"
			while IFS='|' read -r name host port insp dir cmd; do
				[[ -z "$name" ]] && continue
				if [[ "$port" == "-" ]]; then
					printf "  %-22s %-6s %s\n" "$host" "—" "(watch build, no port)"
				else
					code=$(curl -s -o /dev/null -w '%{http_code}' -m 3 "http://localhost:${port}/" 2>/dev/null)
					[[ "$code" == "000" ]] && code="DOWN"
					printf "  %-22s %-6s %s\n" "$host" "$port" "$code"
				fi
			done <<< "$(_sipio_all_services)"
			echo "  (404 = worker up, no route at /)"
			;;
		seed)
			( cd "$SIPIO_ROOT/platform-dev" && npm run seed && npm run seed:finance && npm run drift )
			;;
		drift)
			( cd "$SIPIO_ROOT/platform-dev" && npm run drift )
			;;
		run)
			# sipio run <svc> [<svc>…]   → each in its own cmux tab
			# sipio run <svc> --here     → run it in THIS shell, foreground
			_sipio_run "$@" || return 1
			;;
		open)
			local row port
			row=$(_sipio_lookup "$1")
			[[ -z "$row" ]] && { echo "unknown service: $1  (try: sipio ls)"; return 1; }
			port=$(print -r -- "$row" | cut -d'|' -f3)
			[[ "$port" == "-" ]] && { echo "$1 has no HTTP port"; return 1; }
			open "http://localhost:${port}"
			;;
		web)
			local row host
			row=$(_sipio_lookup "$1")
			[[ -z "$row" ]] && { echo "unknown service: $1  (try: sipio ls)"; return 1; }
			host=$(print -r -- "$row" | cut -d'|' -f2)
			[[ "$host" == "webphone" ]] && { echo "webphone is a watch build, no host"; return 1; }
			open "https://${host}"
			;;
		ls|list)
			local name host port insp dir cmd
			printf "  %-6s %-22s %-6s %-5s %s\n" "SVC" "HOST" "PORT" "INSP" "DIR"
			while IFS='|' read -r name host port insp dir cmd; do
				[[ -z "$name" ]] && continue
				printf "  %-6s %-22s %-6s %-5s %s\n" "$name" "$host" "$port" "$insp" "$dir"
			done <<< "$(_sipio_all_services)"
			;;
		help|-h|--help)
			cat <<'HELP'
  sipio run <svc>…       start (or restart) one or more services, a cmux tab each
                         e.g. sipio run fe app idp
  sipio run <svc> --here run it in THIS shell instead (foreground, Ctrl+C stops)
  sipio <svc>…           shorthand for `sipio run <svc>…`
  sipio all              core stack: idp app ctl fin pay did crm mon fe
  sipio full             everything, incl. contaqt-new + the Vite frontends
  sipio stop             kill every service (service + inspector port), close its tab
  sipio status           host-by-host health table
  sipio seed             migrate + seed all planes, then drift-check
  sipio drift            drift-check only
  sipio open <svc>       open http://localhost:<port>   (always works)
  sipio web  <svc>       open https://<svc>.sip.test    (needs the valet proxies)
  sipio ls               list services, hostnames, ports and directories

  <svc> accepts the short name (app), the hostname (app.sip.test)
  or the repo directory (pbx-api).
HELP
			;;
		*)
			_sipio_run "$sub" "$@" || return 1
			;;
	esac
}
